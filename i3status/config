general {
  colors = true
  interval = 5
}

#order += "ipv6"
order += "ethernet wg0"
order += "wireless wlan0"
order += "ethernet eth0"
order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless wlan0 {
  format_up = "wlan0: %essid - %ip [%quality]"
  format_down = "wlan0: down"
}

ethernet eth0 {
  format_up = "eth0: %ip [%speed]"
  format_down = "eth0: down"
}

battery all {
  format = "%status %percentage"
}

load {
  format = "Load: %1min"
}

memory {
  format = "MEM: %used"
  threshold_degraded = "1G"
  format_degraded = "MEMORY < %available"
}

tztime local {
  format = "%Y-%b-%d %I:%M %p |"
}

#ipv6 {
#  format_up = "%iface: %ip"
#  format_down = "no IPv6"
#}

disk "/" {
  format = "Collected Evidence: %used"
}

ethernet wg0 {
  format_up = "wg0: %ip"
  format_down = "wg0: down"
}


