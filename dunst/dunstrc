[global]
    monitor = 0
    follow = none

    width = (0, 400)
    height = (0, 250)
    origin = top-right
    offset = (12, 40)
    gap_size = 6

    frame_width = 1
    frame_color = "#285577"
    corner_radius = 0
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    separator_height = 1
    separator_color = frame

    font = "DejaVu Sans Mono 12"
    markup = full
    format = "<small>%a</small>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = end

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita"

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

    sort = urgency_descending
    stack_duplicates = true
    history_length = 20
    sticky_history = yes

    layer = overlay

[urgency_low]
    background = "#000000D5"
    foreground = "#ffffff"
    frame_color = "#285577"
    timeout = 4

[urgency_normal]
    background = "#000000D5"
    foreground = "#ffffff"
    frame_color = "#285577"
    timeout = 8

[urgency_critical]
    background = "#000000D5"
    foreground = "#ffffff"
    frame_color = "#ff5555"
    timeout = 0
