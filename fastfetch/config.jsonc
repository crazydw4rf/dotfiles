{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10,
    },
    "separator": "",
  },
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo/logo.png",
    "width": 23,
    "height": 14,
    "padding": {
      "top": 0,
      "left": 1,
    },
  },
  "modules": [
    "break",
    {
      "type": "host",
      "key": "host",
      "keyColor": "#CBA6F7",
      "format": "{name}",
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "#94E2D5",
      "format": "{name}",
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "#74C7EC",
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "#F9E2AF",
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "#F5C2E7",
      "format": "{pretty-name}",
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "#94E2D5",
      "format": "{pretty-name}",
    },
    {
      "type": "terminalfont",
      "key": "font",
      "keyColor": "#F5C2E7",
    },
    {
      "type": "command",
      "key": "wm",
      "keyColor": "#89DCEB",
      "text": "echo $XDG_SESSION_DESKTOP",
      "format": "{}",
    },
    {
      "type": "uptime",
      "key": "up",
      "keyColor": "#FAB387",
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "#CBA6F7",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "ram",
      "keyColor": "#94E2D5",
      "format": "{used} / {total}",
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "#74C7EC",
      "folders": ["/"],
      "format": "{size-used} / {size-total}",
    },
    {
      "type": "battery",
      "key": "bat",
      "keyColor": "#A6E3A1",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;249;226;175m󰮯 \u001b[0m \u001b[38;2;203;166;247m󰊠 \u001b[0m \u001b[38;2;116;199;236m󰊠 \u001b[0m \u001b[38;2;245;194;231m󰊠 \u001b[0m \u001b[38;2;250;179;135m󰊠 \u001b[0m \u001b[38;2;166;227;161m󰊠 \u001b[0m \u001b[38;2;148;226;213m󰊠 \u001b[0m \u001b[38;2;180;190;254m󰊠 \u001b[0m ",
    },
    "break",
  ],
}
