env {
  EDITOR "nvim"
}

ui {
  pane_frames {
    rounded_corners false
    hide_session_name false
  }
}

theme "rose-pine-moon"

keybinds {
    unbind "Ctrl s"
    unbind "Ctrl g"
    unbind "Ctrl h"
    unbind "Ctrl q"
    unbind "Ctrl p"
    unbind "Ctrl n"
    unbind "Ctrl m"
    unbind "Ctrl b"

    search {
        unbind "u"
        unbind "d"

        bind "e" { EditScrollback; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { PageScrollDown; }
        bind "Ctrl u" { PageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "s" "/" { SwitchToMode "EnterSearch"; SearchInput 0; }

        bind "Esc" "Alt s" "q" { SwitchToMode "Normal"; }
    }

    locked {
        bind "Alt q" { SwitchToMode "Normal"; }
        bind "Ctrl m" { Quit; }
    }

    shared_except "locked" {
      unbind "Ctrl g"
      unbind "Ctrl h"
      unbind "Ctrl b"

      bind "Alt q" { SwitchToMode "Locked"; }
      bind "Alt m" { SwitchToMode "Move"; }
      bind "Alt y" { SwitchToMode "Resize"; }
      bind "Alt s" { SwitchToMode "Search"; }
      bind "Alt p" { SwitchToMode "Pane"; }
    }

    tab {
      unbind "n"

      bind "a" { NewTab; SwitchToMode "Normal"; }
    }

    normal {
      unbind "Ctrl s"
      unbind "Ctrl g"
      unbind "Ctrl h"
      unbind "Ctrl q"
      unbind "Ctrl p"
      unbind "Ctrl n"
      unbind "Ctrl m"

        bind "Alt t" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Alt r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "Alt a" {
          LaunchPlugin "zellij:session-manager" {
            floating true
            move_to_focused_pane true
          };

          SwitchToMode "Normal";
        }
    }

    renametab {
      bind "Esc" { SwitchToMode "Normal"; }
    }

    renamepane {
      bind "Esc" { SwitchToMode "Normal"; }
    }

    move {
      bind "Esc" "Enter" { SwitchToMode "Normal"; }
    }
}

on_force_close "detach"
simplified_ui true
default_cwd "~"
pane_frames false
auto_layout true
session_serialization true
serialize_pane_viewport false
scrollback_lines_to_serialize 10000
default_layout "compact"
default_mode "normal"
mouse_mode true
scroll_buffer_size 10000
copy_clipboard "system"
copy_on_select true
mirror_session false
styled_underlines true
disable_session_metadata false
stacked_resize true
advanced_mouse_actions false
web_server false
web_sharing "disabled"
web_client {
  font "monospace"
}
// web_server_ip "127.0.0.1"
// web_server_port 8082
// web_server_cert "/path/to/my/cert.pem"
// web_server_key "/path/to/my/key.pem"
// enforce_https_for_localhost true

