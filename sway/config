font pango:ZedMono NF Medium 8

exec dex -a -e sway
exec swaybg -m fill -i $HOME/.wallpaper
exec dunst
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

output eDP-1 scale 1

include keybinds
include window_rules
include bar
