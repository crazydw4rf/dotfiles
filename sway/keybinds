# vim: set filetype=i3config :

set $up k
set $down j
set $left h
set $right l
set $mod Mod4
set $ipc noctalia msg

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
# tiling_drag modifier titlebar

bindsym $mod+Shift+space exec $ipc panel-toggle launcher
bindsym $mod+Shift+comma exec $ipc panel-toggle control-center
bindsym $mod+comma exec $ipc settings-toggle
bindsym --no-repeat $mod+q kill
bindsym --no-repeat $mod+Return exec kitty -1
bindsym --no-repeat $mod+m exec kitty -1 --class rmpc -e rmpc
bindsym --no-repeat $mod+space exec pkill wmenu || j4-dmenu-desktop -I --dmenu='wmenu -p Launch: -i'
# bindsym --no-repeat $mod+v exec cliphist list | fuzzel --dmenu | cliphist decode | wl-copy
bindsym --no-repeat $mod+v exec noctalia msg panel-toggle clipboard
bindsym --no-repeat $mod+e exec kitty -1 --class "yazi" -e yazi
bindsym --no-repeat $mod+Shift+v exec audio_dev_switcher
bindsym --no-repeat $mod+Shift+a exec FILE="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png" && grim "$FILE" && wl-copy < "$FILE"
bindsym --no-repeat $mod+Shift+s exec FILE="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png" && grim -g "$(slurp)" "$FILE" && wl-copy < "$FILE"
bindsym --no-repeat Mod1+Shift+a exec grim - | swappy -f - -o "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"
bindsym --no-repeat Mod1+Shift+s exec grim -g "$(slurp)" - | swappy -f - -o "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"
bindsym --locked --no-repeat $mod+Shift+x exec hyprlock
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_SINK@ 2%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_SINK@ 2%-
bindsym --locked --no-repeat XF86AudioMute exec wpctl set-mute @DEFAULT_SINK@ toggle
bindsym --locked --no-repeat XF86AudioMicMute exec wpctl set-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +2%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 2%-

# change focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+$right move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$left move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym --no-repeat $mod+o split h

# split in vertical orientation
bindsym --no-repeat $mod+p split v

# enter fullscreen mode for the focused container
bindsym --no-repeat $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym --no-repeat Mod1+Shift+x layout stacking
bindsym --no-repeat Mod1+Shift+w layout tabbed
bindsym --no-repeat Mod1+Shift+e layout toggle split

bindsym $mod+bracketright workspace next
bindsym $mod+bracketleft workspace prev

# toggle tiling / floating
bindsym --no-repeat $mod+s floating toggle

# change focus between tiling / floating windows
bindsym --no-repeat $mod+z focus mode_toggle

# focus the parent container
bindsym $mod+Shift+z focus parent

# focus the child container
bindsym $mod+d focus child

# move the currently focused window to the scratchpad
bindsym $mod+plus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+Shift+minus scratchpad show

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym Mod1+1 move container to workspace number $ws1
bindsym Mod1+2 move container to workspace number $ws2
bindsym Mod1+3 move container to workspace number $ws3
bindsym Mod1+4 move container to workspace number $ws4
bindsym Mod1+5 move container to workspace number $ws5
bindsym Mod1+6 move container to workspace number $ws6
bindsym Mod1+7 move container to workspace number $ws7
bindsym Mod1+8 move container to workspace number $ws8
bindsym Mod1+9 move container to workspace number $ws9
bindsym Mod1+0 move container to workspace number $ws10

# reload the configuration file
bindsym --no-repeat $mod+Shift+c reload

# resize window (you can also use the mouse for that)
mode "resize" {
  # These bindings trigger as soon as you enter the resize mode

  # Pressing left will shrink the window’s width.
  # Pressing right will grow the window’s width.
  # Pressing up will shrink the window’s height.
  # Pressing down will grow the window’s height.
  bindsym $left       resize shrink width 10 px or 10 ppt
  bindsym $down       resize grow height 10 px or 10 ppt
  bindsym $up         resize shrink height 10 px or 10 ppt
  bindsym $right      resize grow width 10 px or 10 ppt

  # same bindings, but for the arrow keys
  bindsym Left        resize shrink width 10 px or 10 ppt
  bindsym Down        resize grow height 10 px or 10 ppt
  bindsym Up          resize shrink height 10 px or 10 ppt
  bindsym Right       resize grow width 10 px or 10 ppt


  # back to normal: Enter or Escape or $mod+r
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym --no-repeat $mod+r mode "resize"

set $power_menu "Power Menu: [s]leep [h]ibernate [l]ogout [r]eboot [u]shutdown"

mode $power_menu {
  bindsym s exec systemctl suspend; mode "default"
  bindsym h exec sh -c "loginctl lock-session && systemctl hibernate"; mode "default"
  bindsym r exec systemctl reboot; mode "default"
  bindsym u exec systemctl poweroff; mode "default"
  bindsym l exec swaymsg exit

  bindsym Return mode "default"
  bindsym Escape mode "default"
}

bindsym --no-repeat $mod+backspace mode $power_menu

bindsym $mod+equal exec swaymsg 'resize grow width 50 px' && sleep 0.01 && swaymsg 'resize grow height 20 px'
bindsym $mod+minus exec swaymsg 'resize shrink width 50 px' && sleep 0.01 && swaymsg 'resize shrink height 20 px'
