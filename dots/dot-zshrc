# vim: set filetype=zsh :
# shellcheck disable=SC2086,SC2154,SC1090,SC1091

export ZELLIJ_AUTO_ATTACH=false
export ZELLIJ_AUTO_EXIT=true
export EDITOR="nvim --clean"

autoload -Uz compinit && compinit

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# plugins
zi light zsh-users/zsh-autosuggestions
zi light zsh-users/zsh-syntax-highlighting
zi light Aloxaf/fzf-tab
zi light ptavares/zsh-direnv
zi light BlaineEXE/zsh-cmd-status

# ohmyzsh
zi snippet OMZL::git.zsh
zi snippet OMZL::completion.zsh
zi snippet OMZL::history.zsh
zi snippet OMZL::key-bindings.zsh
zi snippet OMZL::async_prompt.zsh
zi snippet OMZL::spectrum.zsh
zi snippet OMZL::theme-and-appearance.zsh
zi snippet OMZL::clipboard.zsh
zi snippet OMZL::functions.zsh
zi snippet OMZL::termsupport.zsh
zi snippet OMZL::spectrum.zsh
zi snippet OMZL::directories.zsh
zi snippet OMZP::git

# prompt theme
zi cdclear -q
setopt promptsubst
# shellcheck disable=SC2034
host_color="green"
# shellcheck disable=SC2034
user_color="white"
zi snippet OMZT::fishy

(( $+commands[fzf] ))     && source <(fzf --zsh)
(( $+commands[zoxide] ))  && source <(zoxide init zsh)

[ -f "$HOME/.aliases" ]   && source "$HOME/.aliases"

[[ "$TERM_PROGRAM" == "tmux" || -z "$TERM_PROGRAM" ]] && {
  (( $+commands[fastfetch] )) && env -u ZELLIJ fastfetch
  (( $+commands[task] ))      && task due:today or due:tomorrow or due:2day list 2>/dev/null
} || true

export KEYTIMEOUT=1
bindkey -v

function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]]; then
    echo -ne '\e[2 q'
  else
    echo -ne '\e[5 q'
  fi
}
zle -N zle-keymap-select

function zle-line-init {
  echo -ne '\e[5 q'
};
zle -N zle-line-init

autoload -Uz incarg
zle -N incarg

function vicmd-incarg {
  zle incarg -- 1
}
function vicmd-decarg {
  zle incarg -- -1
}
zle -N vicmd-incarg
zle -N vicmd-decarg

bindkey -M vicmd '^A' vicmd-incarg
bindkey -M vicmd '^X' vicmd-decarg

# text objects
autoload -Uz select-bracketed select-quoted
zle -N select-bracketed
zle -N select-quoted
for km in viopp visual; do
  # shellcheck disable=SC2296
  for c in {a,i}${(s..)^:-'()[]{}<>bB'}; do
    bindkey -M $km $c select-bracketed
  done
  for c in {a,i}{\',\",\`}; do
    bindkey -M $km $c select-quoted
  done
done

# common vim motions
bindkey -M vicmd 'H' beginning-of-line
bindkey -M vicmd 'L' end-of-line
bindkey -M vicmd 'u' undo
bindkey -M vicmd '^R' redo
bindkey -M vicmd '/' fzf-history-widget
bindkey -M vicmd '^U' up-line
bindkey -M vicmd '^D' down-line
bindkey '^W' backward-kill-word

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd '^V' edit-command-line

