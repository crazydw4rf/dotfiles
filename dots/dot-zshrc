# vim: set filetype=zsh syntax=bash :

export ZELLIJ_AUTO_ATTACH=false
export ZELLIJ_AUTO_EXIT=true

export GUM_FILTER_PROMPT_FOREGROUND="#575279"
export GUM_FILTER_TEXT_FOREGROUND="#575279"
export GUM_FILTER_MATCH_FOREGROUND="#D7827E"
export GUM_FILTER_INDICATOR_FOREGROUND="#56949F"
export GUM_FILTER_PLACEHOLDER_FOREGROUND="#9893A5"

if (( $+commands[zellij] )) && [[ -z "$ZELLIJ" && -z "$NVIM" && -z "$VSCODE_NONCE" && -z "$ZED_TERM" && -z "$SSH" ]]; then
  if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
    zellij attach -c
  else
    layout_dir="$HOME/.config/zellij/layouts"
    items=()

    while IFS= read -r f; do
      items+=("layout:${f:t:r}")
    done < <(find "$layout_dir" -maxdepth 1 -name "*.kdl" 2>/dev/null)

    while IFS= read -r s; do
      [[ -n "$s" ]] && items+=("attach:$s")
    done < <(zellij list-sessions --no-formatting 2>/dev/null | awk '!/EXITED/{print $1}')

    while IFS= read -r s; do
      [[ -n "$s" ]] && items+=("resurrect:$s")
    done < <(zellij list-sessions --no-formatting 2>/dev/null | awk '/EXITED/{print $1}')

    items+=("no-zellij")

    choice=$(printf '%s\n' "${items[@]}" | gum filter --no-show-help --placeholder "zellij..." --height 15)
    gum_status=$?

    if [[ $gum_status -eq 0 ]]; then
      if [[ "$choice" == "no-zellij" ]]; then
        true
      elif [[ "$choice" == layout:* ]]; then
        exec zellij --layout "${choice#layout:}"
      elif [[ "$choice" == attach:* ]]; then
        exec zellij attach "${choice#attach:}"
      elif [[ "$choice" == resurrect:* ]]; then
        exec zellij attach "${choice#resurrect:}"
      fi
    fi
  fi
fi

clear

autoload -Uz compinit && compinit

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# plugins
zi light zsh-users/zsh-autosuggestions
zi light zsh-users/zsh-syntax-highlighting
zi light Aloxaf/fzf-tab
zi light ptavares/zsh-direnv
zi light BlaineEXE/zsh-cmd-status

# ohmyzsh
zi snippet OMZL::git.zsh
zi snippet OMZL::completion.zsh
zi snippet OMZL::history.zsh
zi snippet OMZL::key-bindings.zsh
zi snippet OMZL::async_prompt.zsh
zi snippet OMZL::spectrum.zsh
zi snippet OMZL::theme-and-appearance.zsh
zi snippet OMZL::clipboard.zsh
zi snippet OMZL::functions.zsh
zi snippet OMZL::termsupport.zsh
zi snippet OMZL::spectrum.zsh
zi snippet OMZL::directories.zsh
zi snippet OMZP::git

# prompt theme
zi cdclear -q
setopt promptsubst
host_color="green"
user_color="white"
zi snippet OMZT::fishy

(( $+commands[fzf] ))     && source <(fzf --zsh)
(( $+commands[zoxide] ))  && source <(zoxide init zsh)

[ -x "$HOME/.aliases" ]   && source "$HOME/.aliases"

[[ "$TERM_PROGRAM" == "tmux" || -z "$TERM_PROGRAM" ]] && {
  (( $+commands[fastfetch] )) && fastfetch
  (( $+commands[task] ))      && task due:today or due:tomorrow or due:2day list 2>/dev/null
} || true

KEYTIMEOUT=1
bindkey -v
bindkey '^W' backward-kill-word

function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]]; then
    echo -ne '\e[2 q'
  elif [[ ${KEYMAP} == main ]] || [[ ${KEYMAP} == viins ]] || [[ ${KEYMAP} = '' ]]; then
    echo -ne '\e[5 q'
  fi
}
zle -N zle-keymap-select

zle-line-init(){ echo -ne '\e[5 q' }
zle -N zle-line-init

autoload -Uz incarg
zle -N vicmd-incarg incarg
zle -N vicmd-decarg incarg

vicmd-incarg(){ incarg 1 }
vicmd-decarg(){ incarg -1 }

zle -N vicmd-incarg
zle -N vicmd-decarg

bindkey -M vicmd '^A' vicmd-incarg
bindkey -M vicmd '^X' vicmd-decarg

